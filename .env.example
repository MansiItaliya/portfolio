# Spring Boot Server Configuration
PORTFOLIO_SERVER_PORT=8080

# Portfolio Owner Email Configuration
PORTFOLIO_OWNER_EMAIL=owner@example.com

# SMTP Mail Server Configuration (Gmail Example)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true

# CORS Allowed Origins (Comma-separated for dev and production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://yourdomain.com

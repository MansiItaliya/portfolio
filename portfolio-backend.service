[Unit]
Description=Java Spring Boot Portfolio Backend Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/portfolio/backend
ExecStart=/usr/bin/java -jar /var/www/portfolio/backend/target/portfolio-0.0.1-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

Environment=PORTFOLIO_SERVER_PORT=8080
Environment=PORTFOLIO_OWNER_EMAIL=owner@example.com
Environment=SPRING_MAIL_HOST=smtp.gmail.com
Environment=SPRING_MAIL_PORT=587
Environment=SPRING_MAIL_USERNAME=your-email@gmail.com
Environment=SPRING_MAIL_PASSWORD=your-app-password

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
